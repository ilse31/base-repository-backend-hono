{
  "name": "clean-architecture-backend",
  "version": "1.0.0",
  "description": "Clean architecture backend with Hono, PostgreSQL, Redis, and Prisma",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "docker:build": "docker build -t clean-architecture-backend .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:app": "docker-compose logs -f app",
    "docker:restart": "docker-compose restart",
    "docker:clean": "docker-compose down -v --rmi local",
    "docker:prisma": "docker-compose run --rm prisma-studio"
  },
  "keywords": [
    "hono",
    "postgresql",
    "redis",
    "prisma",
    "clean-architecture"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@hono/swagger-ui": "^0.3.0",
    "@hono/zod-openapi": "^0.19.10",
    "@hono/zod-validator": "^0.2.1",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/sdk-node": "^0.48.0",
    "@opentelemetry/auto-instrumentations-node": "^0.41.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.48.0",
    "@opentelemetry/exporter-jaeger": "^1.17.0",
    "hono": "^4.0.10",
    "ioredis": "^5.3.2",
    "nodemailer": "^6.9.13",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "pg": "^8.20.0",
    "prisma": "^7.4.2",
    "redis": "^4.6.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/pg": "^8.18.0",
    "@types/nodemailer": "^6.4.14",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "ts-node": "^10.9.0"
  }
}
