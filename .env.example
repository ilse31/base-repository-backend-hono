# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/clean_architecture_db"

# Redis Configuration (no password for development)
REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=3000
NODE_ENV=development

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_NAME="Clean Architecture API"
SMTP_FROM_EMAIL="noreply@yourdomain.com"

# Admin Email for Alerts and Reports
ADMIN_EMAIL="admin@yourdomain.com"

# Frontend URL for Password Reset Links
FRONTEND_URL="http://localhost:3000"

# Job Queue Configuration
JOB_QUEUE_INTERVAL=5000
JOB_RETRY_DELAY=1000

# Cron Job Configuration
ENABLE_CRON_JOBS=true

# Email Templates
EMAIL_TEMPLATES_DIR="./src/infrastructure/email/templates"

# Optional: Redis with password (uncomment if needed)
# REDIS_URL="redis://:yourpassword@localhost:6379"

# Optional: Different Redis host (uncomment if needed)
# REDIS_URL="redis://your-redis-host:6379"

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=clean-architecture-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
JAEGER_ENDPOINT=http://localhost:14268/api/traces
